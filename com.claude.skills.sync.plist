<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 任务标识符 -->
    <key>Label</key>
    <string>com.claude.skills.sync</string>

    <!-- 要执行的程序和参数 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/laichaochang/Documents/Claude/auto_sync_skills.sh</string>
    </array>

    <!-- 每小时执行一次 (3600 秒) -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- 系统启动时也执行一次 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 标准输出日志 -->
    <key>StandardOutPath</key>
    <string>/tmp/claude-skills-launchd.log</string>

    <!-- 错误输出日志 -->
    <key>StandardErrorPath</key>
    <string>/tmp/claude-skills-launchd.error.log</string>

    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/laichaochang/Documents/Claude</string>

    <!-- 即使程序退出也保持任务活跃 -->
    <key>KeepAlive</key>
    <false/>

    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
